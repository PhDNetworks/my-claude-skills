{
  "id": "hero-section",
  "elType": "section",
  "settings": {
    "layout": "full_width",
    "content_position": "middle",
    "height": "min-height",
    "custom_height": {"unit": "vh", "size": 70},
    "background_background": "classic",
    "background_color": "#ffffff",
    "padding": {"top": "60", "right": "20", "bottom": "60", "left": "20", "unit": "px"},
    "margin": {"top": "0", "bottom": "0", "unit": "px"}
  },
  "elements": [
    {
      "id": "hero-container",
      "elType": "column",
      "settings": {
        "content_position": "center",
        "_column_size": 100
      },
      "elements": [
        {
          "id": "hero-heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{H1}}",
            "header_size": "h1",
            "align": "center",
            "title_color": "#1a1a1a",
            "typography_typography": "custom",
            "typography_font_family": "Archivo",
            "typography_font_size": {"unit": "px", "size": 48},
            "typography_font_weight": "700",
            "typography_line_height": {"unit": "em", "size": 1.2}
          }
        },
        {
          "id": "hero-subheading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Trusted local experts serving {{LOCATION}} for over 10 years",
            "header_size": "h2",
            "align": "center",
            "title_color": "#666666",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 20},
            "typography_font_weight": "400",
            "margin": {"top": "20", "bottom": "30", "unit": "px"}
          }
        },
        {
          "id": "hero-cta",
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "Get Free Quote",
            "link": {"url": "tel:{{PHONE}}"},
            "align": "center",
            "size": "lg",
            "button_type": "primary",
            "background_color": "#2563eb",
            "hover_color": "#1d4ed8",
            "border_radius": {"unit": "px", "size": 8},
            "typography_typography": "custom",
            "typography_font_weight": "600",
            "text_padding": {"top": "16", "right": "32", "bottom": "16", "left": "32", "unit": "px"}
          }
        },
        {
          "id": "hero-trust-row",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<div style='display:flex;justify-content:center;gap:24px;margin-top:30px;flex-wrap:wrap;'><span>⭐ 4.9 Rating</span><span>✓ Fully Insured</span><span>✓ Free Quotes</span><span>✓ 10+ Years Experience</span></div>",
            "align": "center",
            "text_color": "#666666"
          }
        }
      ]
    }
  ]
}
