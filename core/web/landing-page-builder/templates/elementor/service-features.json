{
  "id": "services-section",
  "elType": "section",
  "settings": {
    "layout": "boxed",
    "background_background": "classic",
    "background_color": "#ffffff",
    "padding": {"top": "60", "right": "20", "bottom": "60", "left": "20", "unit": "px"}
  },
  "elements": [
    {
      "id": "services-heading",
      "elType": "widget",
      "widgetType": "heading",
      "settings": {
        "title": "Our Services",
        "header_size": "h2",
        "align": "center",
        "title_color": "#1a1a1a",
        "typography_typography": "custom",
        "typography_font_size": {"unit": "px", "size": 36},
        "typography_font_weight": "700",
        "margin": {"bottom": "40", "unit": "px"}
      }
    },
    {
      "id": "services-grid",
      "elType": "container",
      "settings": {
        "flex_direction": "row",
        "flex_wrap": "wrap",
        "justify_content": "center",
        "flex_gap": {"unit": "px", "size": 24}
      },
      "elements": [
        {
          "id": "service-card-1",
          "elType": "container",
          "settings": {
            "flex_direction": "column",
            "width": {"unit": "%", "size": 30},
            "min_width": {"unit": "px", "size": 280},
            "background_background": "classic",
            "background_color": "#f8fafc",
            "border_radius": {"unit": "px", "size": 12},
            "padding": {"top": "24", "right": "24", "bottom": "24", "left": "24", "unit": "px"}
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "icon",
              "settings": {
                "icon": {"value": "fas fa-tools", "library": "fa-solid"},
                "icon_color": "#2563eb",
                "icon_size": {"unit": "px", "size": 48}
              }
            },
            {
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Service Name 1",
                "header_size": "h3",
                "title_color": "#1a1a1a",
                "typography_font_weight": "600"
              }
            },
            {
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "Brief description of service and benefits to the customer.",
                "text_color": "#666666"
              }
            }
          ]
        },
        {
          "id": "service-card-2",
          "elType": "container",
          "settings": {
