{
  "id": "contact-section",
  "elType": "section",
  "settings": {
    "layout": "boxed",
    "background_background": "classic",
    "background_color": "#ffffff",
    "padding": {"top": "60", "right": "20", "bottom": "60", "left": "20", "unit": "px"}
  },
  "elements": [
    {
      "id": "contact-container",
      "elType": "container",
      "settings": {
        "flex_direction": "row",
        "flex_wrap": "wrap",
        "justify_content": "space-between",
        "align_items": "flex-start",
        "flex_gap": {"unit": "px", "size": 40}
      },
      "elements": [
        {
          "id": "contact-info",
          "elType": "container",
          "settings": {
            "flex_direction": "column",
            "width": {"unit": "%", "size": 45},
            "min_width": {"unit": "px", "size": 300}
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Get In Touch",
                "header_size": "h2",
                "title_color": "#1a1a1a",
                "typography_font_weight": "700",
                "margin": {"bottom": "24", "unit": "px"}
              }
            },
            {
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": [
                  {
                    "text": "{{PHONE}}",
                    "selected_icon": {"value": "fas fa-phone", "library": "fa-solid"},
                    "link": {"url": "tel:{{PHONE}}"}
                  },
                  {
                    "text": "info@{{BUSINESS_NAME}}.co.uk",
                    "selected_icon": {"value": "fas fa-envelope", "library": "fa-solid"},
                    "link": {"url": "mailto:info@example.co.uk"}
                  },
                  {
                    "text": "{{LOCATION}}, West Yorkshire",
                    "selected_icon": {"value": "fas fa-map-marker-alt", "library": "fa-solid"}
                  }
                ],
                "icon_color": "#2563eb",
                "text_color": "#1a1a1a",
                "icon_size": {"unit": "px", "size": 18},
                "space_between": {"unit": "px", "size": 16}
              }
            },
            {
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<strong>Opening Hours:</strong><br>Monday - Friday: 8am - 6pm<br>Saturday: 9am - 2pm<br>Sunday: Emergency calls only",
                "text_color": "#666666",
                "margin": {"top": "24", "unit": "px"}
              }
            }
          ]
        },
        {
          "id": "contact-form-container",
          "elType": "container",
          "settings": {
            "flex_direction": "column",
            "width": {"unit": "%", "size": 50},
            "min_width": {"unit": "px", "size": 300},
            "background_background": "classic",
            "background_color": "#f8fafc",
            "border_radius": {"unit": "px", "size": 12},
            "padding": {"top": "32", "right": "32", "bottom": "32", "left": "32", "unit": "px"}
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Request a Free Quote",
                "header_size": "h3",
                "title_color": "#1a1a1a",
                "typography_font_weight": "600",
                "margin": {"bottom": "24", "unit": "px"}
              }
            },
            {
              "elType": "widget",
              "widgetType": "form",
              "settings": {
                "form_name": "Landing Page Contact Form",
                "form_fields": [
                  {
                    "field_type": "text",
                    "field_label": "Your Name",
                    "placeholder": "Enter your name",
                    "required": "yes",
                    "width": "100"
                  },
                  {
                    "field_type": "tel",
                    "field_label": "Phone Number",
                    "placeholder": "Enter your phone number",
                    "required": "yes",
                    "width": "100"
                  },
                  {
                    "field_type": "email",
                    "field_label": "Email Address",
                    "placeholder": "Enter your email",
                    "required": "no",
                    "width": "100"
                  },
                  {
                    "field_type": "textarea",
                    "field_label": "Message",
                    "placeholder": "Tell us about your project",
                    "required": "no",
                    "width": "100",
                    "rows": 4
                  }
                ],
                "button_text": "Get Free Quote",
                "button_size": "lg",
                "button_width": "100",
                "button_background_color": "#2563eb",
                "button_hover_color": "#1d4ed8",
                "email_to": "info@example.co.uk",
                "email_subject": "New Lead from Landing Page",
                "success_message": "Thank you! We'll be in touch shortly.",
                "required_field_message": "This field is required"
              }
            }
          ]
        }
      ]
    }
  ]
}
