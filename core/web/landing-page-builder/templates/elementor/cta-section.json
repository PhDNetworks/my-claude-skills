{
  "id": "cta-section",
  "elType": "section",
  "settings": {
    "layout": "full_width",
    "background_background": "classic",
    "background_color": "#1e3a5f",
    "padding": {"top": "60", "right": "20", "bottom": "60", "left": "20", "unit": "px"}
  },
  "elements": [
    {
      "id": "cta-container",
      "elType": "container",
      "settings": {
        "flex_direction": "column",
        "align_items": "center",
        "content_width": "boxed"
      },
      "elements": [
        {
          "id": "cta-heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Ready to Get Started?",
            "header_size": "h2",
            "align": "center",
            "title_color": "#ffffff",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 36},
            "typography_font_weight": "700"
          }
        },
        {
          "id": "cta-subtext",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "Call us now for a free, no-obligation quote. We're available 7 days a week.",
            "align": "center",
            "text_color": "#cbd5e1",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 18},
            "margin": {"top": "16", "bottom": "24", "unit": "px"}
          }
        },
        {
          "id": "cta-phone",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{PHONE}}",
            "header_size": "h3",
            "align": "center",
            "title_color": "#fbbf24",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 32},
            "typography_font_weight": "700",
            "link": {"url": "tel:{{PHONE}}"},
            "margin": {"bottom": "24", "unit": "px"}
          }
        },
        {
          "id": "cta-buttons",
          "elType": "container",
          "settings": {
            "flex_direction": "row",
            "justify_content": "center",
            "flex_gap": {"unit": "px", "size": 16},
            "flex_wrap": "wrap"
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Call Now",
                "link": {"url": "tel:{{PHONE}}"},
                "size": "lg",
                "background_color": "#fbbf24",
                "text_color": "#1e3a5f",
                "hover_color": "#f59e0b",
                "border_radius": {"unit": "px", "size": 8}
              }
            },
            {
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Request Callback",
                "link": {"url": "#contact-form"},
                "size": "lg",
                "button_type": "outline",
                "border_color": "#ffffff",
                "text_color": "#ffffff",
                "hover_color": "#ffffff",
                "hover_text_color": "#1e3a5f",
                "border_radius": {"unit": "px", "size": 8}
              }
            }
          ]
        }
      ]
    }
  ]
}
